    "voice": "zh-CN-XiaoxiaoNeural",
    "size": 11232
  },
  "zh_5d98d84e8e6123": {
    "file": "zh_5d98d84e8e6123.mp3",
    "text": "吩咐",
    "voice": "zh-CN-XiaoxiaoNeural",
    "size": 11232
  },
  "zh_905c552f7a4578": {
    "file": "zh_905c552f7a4578.mp3",
    "text": "安居乐业",
    "voice": "zh-CN-XiaoxiaoNeural",
    "size": 11232
  },
  "zh_11b77be2d3eeb3": {
    "file": "zh_11b77be2d3eeb3.mp3",
    "text": "迫不及待",
    "voice": "zh-CN-XiaoxiaoNeural",
    "size": 11232
  },
  "zh_e9d89089e0e59c": {
    "file": "zh_e9d89089e0e59c.mp3",
    "text": "恩惠",
    "voice": "zh-CN-XiaoxiaoNeural",
    "size": 11232
  },
  "zh_e933286c2f97da": {
    "file": "zh_e933286c2f97da.mp3",
    "text": "平衡",
    "voice": "zh-CN-XiaoxiaoNeural",
    "size": 11232
  },
  "zh_5af40c3fff77df": {
    "file": "zh_5af40c3fff77df.mp3",
    "text": "辉煌",
    "voice": "zh-CN-XiaoxiaoNeural",
    "size": 11232
  },
  "zh_b7320a853313c4": {
    "file": "zh_b7320a853313c4.mp3",
    "text": "繁殖",
    "voice": "zh-CN-XiaoxiaoNeural",
    "size": 11232
  },
  "zh_f3eb57b7c51a66": {
    "file": "zh_f3eb57b7c51a66.mp3",
    "text": "黎明",
    "voice": "zh-CN-XiaoxiaoNeural",
    "size": 11232
  },
  "zh_0555a7e1963eff": {
    "file": "zh_0555a7e1963eff.mp3",
    "text": "领略",
    "voice": "zh-CN-XiaoxiaoNeural",
    "size": 11232
  },
  "zh_336aa4e093e1d7": {
    "file": "zh_336aa4e093e1d7.mp3",
    "text": "明月松间照，清泉石上流。",
    "voice": "zh-CN-YunxiNeural",
    "size": 25776
  },
  "zh_30654fc4f5e21a": {
    "file": "zh_30654fc4f5e21a.mp3",
    "text": "月落乌啼霜满天，江枫渔火对愁眠。",
    "voice": "zh-CN-YunxiNeural",
    "size": 29664
  },
  "zh_ccf1302c93e5ee": {
    "file": "zh_ccf1302c93e5ee.mp3",
    "text": "竹喧归浣女，莲动下渔舟。",
    "voice": "zh-CN-YunxiNeural",
    "size": 24480
  },
  "zh_f65db0cf894c3b": {
    "file": "zh_f65db0cf894c3b.mp3",
    "text": "西塞山前白鹭飞，桃花流水鳜鱼肥。",
    "voice": "zh-CN-YunxiNeural",
    "size": 28080
  },
  "zh_4ba9966ed96333": {
    "file": "zh_4ba9966ed96333.mp3",
    "text": "姑苏城外寒山寺，夜半钟声到客船。",
    "voice": "zh-CN-YunxiNeural",
    "size": 30528
  },
  "zh_c858683b8367c7": {
    "file": "zh_c858683b8367c7.mp3",
    "text": "风一更，雪一更，聒碎乡心梦不成。",
    "voice": "zh-CN-YunxiNeural",
    "size": 29952
  },
  "zh_0c0acd9383eafa": {
    "file": "zh_0c0acd9383eafa.mp3",
    "text": "王师北定中原日，家祭无忘告乃翁。",
    "voice": "zh-CN-YunxiNeural",
    "size": 28368
  },
  "zh_8c956c297e0c1d": {
    "file": "zh_8c956c297e0c1d.mp3",
    "text": "问渠那得清如许？为有源头活水来。",
    "voice": "zh-CN-YunxiNeural",
    "size": 32400
  },
  "zh_df3e1cb5cb392b": {
    "file": "zh_df3e1cb5cb392b.mp3",
    "text": "我劝天公重抖擞，不拘一格降人材。",
    "voice": "zh-CN-YunxiNeural",
    "size": 28512
  },
  "zh_a2a2edd60666ac": {
    "file": "zh_a2a2edd60666ac.mp3",
    "text": "死去元知万事空，但悲不见九州同。",
    "voice": "zh-CN-YunxiNeural",
    "size": 29520
  },
  "zh_64bed748a885eb": {
    "file": "zh_64bed748a885eb.mp3",
    "text": "暖风熏得游人醉，直把杭州作汴州。",
    "voice": "zh-CN-YunxiNeural",
    "size": 29520
  },
  "zh_2a55fd9112f9b8": {
    "file": "zh_2a55fd9112f9b8.mp3",
    "text": "九州生气恃风雷，万马齐喑究可哀。",
    "voice": "zh-CN-YunxiNeural",
    "size": 28800
  },
  "zh_913a95ca779fa2": {
    "file": "zh_913a95ca779fa2.mp3",
    "text": "敏而好学，不耻下问。",
    "voice": "zh-CN-YunxiNeural",
    "size": 20448
  },
  "zh_b422d4c4809377": {
    "file": "zh_b422d4c4809377.mp3",
    "text": "知之为知之，不知为不知，是知也。",
    "voice": "zh-CN-YunxiNeural",
    "size": 29952
  },
  "zh_40277e34087292": {
    "file": "zh_40277e34087292.mp3",
    "text": "余尝谓读书有三到，谓心到、眼到、口到。",
    "voice": "zh-CN-YunxiNeural",
    "size": 35568
  },
  "zh_aca918a225a919": {
    "file": "zh_aca918a225a919.mp3",
    "text": "默而识之，学而不厌，诲人不倦。",
    "voice": "zh-CN-YunxiNeural",
    "size": 27936
  },
  "zh_05e047fc9a5b8c": {
    "file": "zh_05e047fc9a5b8c.mp3",
    "text": "盛年不重来，一日难再晨。",
    "voice": "zh-CN-YunxiNeural",
    "size": 24768
  }
}